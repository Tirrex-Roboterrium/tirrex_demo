%%{init: {"flowchart": {"nodeSpacing": 35, "rankSpacing": 45}, "themeVariables": {"fontSize": "22px"}}}%%
flowchart LR
  subgraph inputs["Inputs"]
    direction TB
    path["Selected trajectory"]
    odom["Filtered odometry"]
  end

  subgraph navigation["ROMEA path following"]
    direction TB
    matching["Path matching"]
    state["Path-relative state"]
    following["Path following"]
  end

  subgraph commands["Mobile base"]
    direction TB
    mux["Command mux"]
    controller["Controller"]
  end

  path --> matching
  odom --> matching
  matching --> state
  state --> following
  following --> mux
  mux --> controller

  classDef config fill:#e8f2ff,stroke:#5b8ec7,color:#111,rx:6,ry:6
  classDef processing fill:#eaf7ea,stroke:#5c9f5c,color:#111,rx:6,ry:6
  classDef command fill:#fff6d8,stroke:#c9a227,color:#111,rx:6,ry:6

  class path,odom config
  class matching,state,following processing
  class mux,controller command
  style inputs fill:#f6faff,stroke:#9abbe3,rx:6,ry:6
  style navigation fill:#f7fff7,stroke:#9ecf9e,rx:6,ry:6
  style commands fill:#fffaf0,stroke:#e1c25a,rx:6,ry:6
